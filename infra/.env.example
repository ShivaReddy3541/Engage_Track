# Database Settings
DATABASE_URL=postgresql://lms_user:lms_secure_pass@db:5432/lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_secure_pass
POSTGRES_DB=lms_db

# Event Bus Settings
REDIS_URL=redis://redis:6379/0

# Authentication & Security
JWT_SECRET=supersecretjwtkeyengageai2026version1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dynamic Agent Configurations (Default Thresholds)
# Changing these values alters agent behavior without changing source code.

# Alertness Agent (Drowsiness detection)
ALERTNESS_EAR_THRESHOLD=0.25
ALERTNESS_DROWSY_SECONDS=3.0

# Attendance Agent
ATTENDANCE_ABSENCE_THRESHOLD_MINUTES=10.0
ATTENDANCE_TICK_RATE_SECONDS=5

# Content Moderation Agent
CONTENT_MODERATION_TEXT_THRESHOLD=0.80
CONTENT_MODERATION_IMAGE_THRESHOLD=0.75

# Screen/Video Integrity Agent
INTEGRITY_MOBILE_PHONE_THRESHOLD=0.50
INTEGRITY_MULTIPLE_PEOPLE_THRESHOLD=0.60
EXAM_MODE_STRICTNESS_MULTIPLIER=1.2
